if !exists('g:loaded_custom_vimrc')
  execute 'source' fnameescape(expand('<sfile>:p:h') . '/vimrc')
endif

" Backend-specific mappings and tweaks for Python and web development

" Test runner shortcuts (pytest)
augroup backend_python_test
  autocmd!
  autocmd Filetype python nnoremap <buffer> <F9> :write<cr> :exec '!python3' shellescape(@%, 1)<cr>
  autocmd Filetype python nnoremap <buffer> <F8> :write<cr> :exec '!pytest -vvv ' . shellescape(@%, 1)<cr>
augroup END

" JavaScript / TypeScript project helpers
augroup backend_js_ts
  autocmd!
  autocmd FileType javascript,typescript,typescriptreact,tsx,jsx,vue nnoremap <buffer> <leader>rn :!npm run<Space>
  autocmd FileType javascript,typescript,typescriptreact,tsx,jsx,vue nnoremap <buffer> <leader>nt :!npm test<CR>
  autocmd FileType javascript,typescript,typescriptreact,tsx,jsx,vue nnoremap <buffer> <leader>nb :!npm run build<CR>
augroup END

