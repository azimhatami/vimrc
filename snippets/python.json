{
  "Shebang (python3)": { "prefix": ["#!", "shebang"], "body": ["#!/usr/bin/env python3", "$0"], "description": "Python shebang" },
  "Main guard": { "prefix": ["main", "ifmain"], "body": ["def main() -> None:", "\t${1:pass}", "", "", "if __name__ == \"__main__\":", "\tmain()", "$0"], "description": "main() + __main__ guard" },
  "pytest test": { "prefix": ["test", "deftest"], "body": ["def test_${1:name}(${2}):", "\t${3:assert ${4:True}}", "$0"], "description": "pytest test function" },
  "pytest fixture": { "prefix": ["fixture"], "body": ["@pytest.fixture", "def ${1:name}(${2}):", "\t${3:yield ${4:None}}", "$0"], "description": "pytest fixture" },
  "pytest parametrize": { "prefix": ["param", "parametrize"], "body": ["@pytest.mark.parametrize(\"${1:arg}, ${2:expected}\", [", "\t(${3}, ${4}),", "])", "def test_${5:name}($1, $2):", "\tassert ${6:$1} == $2", "$0"], "description": "pytest parametrized test" },
  "pytest raises": { "prefix": ["raises"], "body": ["with pytest.raises(${1:ValueError}):", "\t${0}"], "description": "pytest.raises block" }
}
