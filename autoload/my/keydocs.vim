" ==============================================================================
"  my#keydocs — long-form descriptions and examples for the README tables.
"  Key: 'Category|modes|lhs'  →  [description, example / when to use]
"  Kept separate from mappings.vim so that file stays easy to scan.
"  tools/test.vim fails if an entry here no longer matches a registered key.
" ==============================================================================

let s:d = {}
function! s:add(key, info, ex) abort
  let s:d[a:key] = [a:info, a:ex]
endfunction

